{
  "private": true,
  "name": "snake-colyseus",
  "version": "1.0.0",
  "description": "Snake on Colyseus: the game server, and its rules engine and bots as an installable package",
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./engine": {
      "types": "./build/engine/index.d.ts",
      "default": "./build/engine/index.js"
    },
    "./bots": {
      "types": "./build/bots/index.d.ts",
      "default": "./build/bots/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "engine": [
        "build/engine/index.d.ts"
      ],
      "bots": [
        "build/bots/index.d.ts"
      ]
    }
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room snake --numClients 2",
    "build": "npm run clean && tsc",
    "clean": "rimraf build",
    "prepare": "tsc --version >/dev/null 2>&1 || exit 0; npm run build",
    "test": "mocha -r tsx -r ./test/setup.ts test/**_test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.16.0",
    "@colyseus/testing": "^0.16.0",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.10.2",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.16.0",
    "@colyseus/playground": "^0.16.0",
    "@colyseus/tools": "^0.16.0",
    "colyseus": "^0.16.0",
    "express": "^4.18.2"
  }
}
